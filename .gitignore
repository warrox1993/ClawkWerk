# Sorties d'audit (peuvent contenir des données client — jamais versionnées)
*.db
/out/
rapport.*
audit.json

# Divers
*.test
*.out

# Worktrees des agents (kit Tagout et superpowers) : un dépôt imbriqué commité par
# un `git add -A` casserait les clones (gitlink vers un commit introuvable).
.claude/worktrees/
.worktrees/
