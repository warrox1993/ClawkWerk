[Unit]
Description=ClawkWerk — questionnaire d'audit CyFun (localhost strict)
After=network.target
Documentation=file:/opt/clawkwerk

[Service]
Type=simple
WorkingDirectory=/opt/clawkwerk
# Écoute sur 127.0.0.1:8099 (loopback strict, jamais exposé au réseau).
# Sortie des réponses dans un tmpfs (/run) : rien ne survit au redémarrage.
RuntimeDirectory=clawkwerk
ExecStart=/opt/clawkwerk/questionnaire -out /run/clawkwerk/responses.json
Restart=on-failure
# Durcissement minimal : pas de privilèges superflus, pas d'écriture système.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/clawkwerk

[Install]
WantedBy=multi-user.target
